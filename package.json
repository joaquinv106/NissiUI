{
  "name": "nissi-ui",
  "version": "0.1.2",
  "description": "Accessible, reusable React components for modular products, operational workflows and SaaS applications",
  "author": "Lic. Informática Joaquin Villegas Chavez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaquinv106/NissiUI.git"
  },
  "homepage": "https://github.com/joaquinv106/NissiUI#readme",
  "bugs": {
    "url": "https://github.com/joaquinv106/NissiUI/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/src/components/theme/index.d.ts",
      "import": "./dist/components/theme/index.js",
      "require": "./dist/components/theme/index.cjs"
    },
    "./styling": {
      "types": "./dist/src/components/styling/index.d.ts",
      "import": "./dist/components/styling/index.js",
      "require": "./dist/components/styling/index.cjs"
    },
    "./panel": {
      "types": "./dist/src/components/panel/index.d.ts",
      "import": "./dist/components/panel/index.js",
      "require": "./dist/components/panel/index.cjs"
    },
    "./document-view": {
      "types": "./dist/src/components/document-view/index.d.ts",
      "import": "./dist/components/document-view/index.js",
      "require": "./dist/components/document-view/index.cjs"
    },
    "./receipt": {
      "types": "./dist/src/components/receipt/index.d.ts",
      "import": "./dist/components/receipt/index.js",
      "require": "./dist/components/receipt/index.cjs"
    },
    "./thermal-print": {
      "types": "./dist/src/components/thermal-print/index.d.ts",
      "import": "./dist/components/thermal-print/index.js",
      "require": "./dist/components/thermal-print/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "AI_CONTEXT.md",
    "llms.txt",
    "CHANGELOG.md",
    "PROJECT_CONTEXT.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "docs:dev": "vite --config vite.docs.config.ts",
    "docs:build": "vite build --config vite.docs.config.ts",
    "docs:preview": "vite preview --config vite.docs.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs && node scripts/check-ssr.mjs && node scripts/check-tree-shaking.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "react",
    "chakra-ui",
    "components",
    "ui",
    "design-system",
    "typescript",
    "vite",
    "saas",
    "dashboard",
    "offline-first"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=3.0.0 <4.0.0",
    "@emotion/react": ">=11.0.0 <12.0.0",
    "next-themes": ">=0.4.4 <1.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/typescript6": "npm:typescript@6.0.0-beta",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.41.0",
    "write-excel-file": "^4.1.1"
  }
}
